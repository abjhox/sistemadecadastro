// Mostra o menu repetidamente até o usuário escolher 0 (Sair).
int main() {
    int opcao;

    // do...while executa o bloco pelo menos uma vez e repete enquanto opcao != 0
    do {
        // Desenha o menu
        printf("\n=============================================\n");
        printf("         SISTEMA DE CADASTRO - LOJA          \n");
        printf("=============================================\n");
        printf("1. Inserir Novo Produto\n");
        printf("2. Listar Produtos (Tabela)\n");
        printf("3. Buscar Produto por Nome ou Categoria\n");
        printf("4. Alterar Produto\n");
        printf("5. Excluir Produto\n");
        printf("6. Ordenar Produtos (Bubble Sort)\n");
        printf("7. Exportar para CSV\n");
        printf("0. Sair\n");
        printf("Escolha uma opcao: ");
        
        // scanf retorna quantos valores leu com sucesso. Se não for 1, o usuário
        // digitou algo que não é número (ex.: letras).
        if (scanf("%d", &opcao) != 1) {
            printf("\nOpcao invalida! Tente novamente.\n");
            limparBuffer(); // Descarta o texto inválido, senão o laço repetiria sem parar
            continue;       // Volta direto ao início do laço (mostra o menu de novo)
        }
        limparBuffer(); // Remove o ENTER que sobrou da leitura

        // switch/case: executa o bloco correspondente ao valor de "opcao".
        // Cada "break" impede que a execução "caia" no case seguinte.
        switch (opcao) {
            case 1:
                inserirProduto();
                break;
            case 2:
                listarProdutos();
                break;
            case 3:
                buscarProdutos();
                break;
            case 4:
                alterarProduto();
                break;
            case 5:
                excluirProduto();
                break;
            case 6:
                ordenarProdutos();
                break;
            case 7:
                exportarParaCSV();
                break;
            case 0:
                printf("\nEncerrando o programa. Ate logo!\n");
                break;
            default:
                // Qualquer número que não seja de 0 a 7
                printf("\nOpcao invalida! Escolha entre 0 e 7.\n");
        }
    } while (opcao != 0);

    return 0; // Indica ao sistema operacional que o programa terminou sem erros
}
